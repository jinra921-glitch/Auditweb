# Used by compose.yaml only. Copy to .env and replace every placeholder.
DB_NAME=wais_audit
DB_USER=wais_user
DB_PASSWORD=replace-with-a-strong-database-password
MYSQL_ROOT_PASSWORD=replace-with-a-strong-root-password
SESSION_SECRET=replace-with-a-long-random-session-secret
WAIS_ADMIN_USERNAME=admin
# Must be at least 12 characters. It is changed at the administrator's first sign-in.
WAIS_ADMIN_PASSWORD=replace-with-a-strong-temporary-admin-password
WAIS_PUBLIC_HOSTNAME=wais.example.com
CADDY_EMAIL=admin@example.com
