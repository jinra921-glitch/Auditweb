# WAIS configuration. Copy this file to backend/.env and replace placeholders.
NODE_ENV=production
HOST=0.0.0.0
PORT=3000
HTTPS_PORT=3443

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=wais_audit
DB_USER=wais_user
DB_PASSWORD=replace-with-a-strong-database-password
DB_CONNECTION_LIMIT=10
DB_QUEUE_LIMIT=100
DB_CONNECT_TIMEOUT_MS=10000
# Set DB_SSL=1 for a remote managed database. Provide a CA file when required.
DB_SSL=0
DB_SSL_CA_PATH=
# For hosts that store certificates as secrets (such as Render), set the full
# PEM certificate in DB_SSL_CA_PEM instead of mounting DB_SSL_CA_PATH.
DB_SSL_CA_PEM=
DB_SSL_REJECT_UNAUTHORIZED=1

# Use at least 32 random characters. Never commit the real value.
SESSION_SECRET=replace-with-a-long-random-session-secret
WAIS_ADMIN_USERNAME=admin
WAIS_ADMIN_PASSWORD=replace-with-a-strong-temporary-admin-password

# Set to 1 only behind a trusted HTTPS reverse proxy or Cloudflare Tunnel.
TRUST_PROXY=0
# Set to 1 only when HTTPS terminates at that trusted proxy. This allows the
# internal HTTP listener to bind to the container/network interface.
WAIS_BEHIND_HTTPS_PROXY=0
# Comma-separated browser origins, if WAIS is hosted separately from its API.
WAIS_FRONTEND_ORIGINS=
UPLOAD_MAX_BYTES=10485760
# "database" stores upload bytes in MariaDB and is intended for ephemeral
# hosts. It keeps the existing 10 MiB per-file limit. Filesystem is default.
WAIS_UPLOAD_STORAGE=filesystem
JSON_BODY_LIMIT=25mb
LOGIN_RATE_LIMIT_MAX_TRACKED_KEYS=10000
SESSION_PRUNE_INTERVAL_MS=21600000

# Without TLS, production WAIS binds only to localhost. Set this to 1 only
# for a short-lived trusted development test; use npm run setup:https for
# normal shared operation.
WAIS_ALLOW_INSECURE_HTTP=0
