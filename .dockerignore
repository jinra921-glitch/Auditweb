# Render only needs the Node runtime and browser assets.
**
!Dockerfile
!.dockerignore
!package.json
!package-lock.json
!backend/app.js
!backend/server.js
!backend/config/*.js
!backend/controllers/*.js
!backend/middleware/*.js
!backend/routes/*.js
!backend/services/*.js
!frontend/*.js
!frontend/*.html
!frontend/*.css
!frontend/*.png
